{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "customManagers:githubActionsVersions"
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/Madrid",
  "schedule": [
    "* 0-5 * * 1"
  ],
  "prConcurrentLimit": 5,
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 4am on Monday"
    ],
    "groupName": "uv.lock maintenance"
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^pyproject\\.toml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=astral-sh/uv\\s+required-version\\s*=\\s*\\\"==(?<currentValue>[^\\\"]+)\\\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "astral-sh/uv",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/workflow-security\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: shellcheck-release\\s+SHELLCHECK_TAG:\\s*\\\"(?<currentValue>v[^\\\"]+)\\\"\\s+SHELLCHECK_SHA256:\\s*\\\"(?<currentDigest>[0-9a-f]{64})\\\""
      ],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "koalaman/shellcheck",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "description": "Group non-major GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "action"
      ],
      "matchUpdateTypes": [
        "digest",
        "patch",
        "minor"
      ],
      "groupName": "GitHub Actions non-major updates"
    },
    {
      "description": "Delay workflow security tooling updates",
      "matchDepNames": [
        "rhysd/actionlint",
        "zizmor",
        "koalaman/shellcheck",
        "go"
      ],
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Group non-major workflow security tooling updates",
      "matchDepNames": [
        "rhysd/actionlint",
        "zizmor",
        "koalaman/shellcheck",
        "go"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "Workflow security tooling"
    },
    {
      "description": "Delay direct validation dependency updates",
      "matchManagers": [
        "pep621",
        "pyenv",
        "custom.regex"
      ],
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Delegate uv.lock release age enforcement to uv",
      "matchManagers": [
        "pep621"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Keep CI Python on the approved 3.14 patch line",
      "matchManagers": [
        "pyenv"
      ],
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "/^3\\.14\\.\\d+$/"
    },
    {
      "description": "Keep the declared Python floor owner-reviewed",
      "matchManagers": [
        "pep621"
      ],
      "matchFileNames": [
        "pyproject.toml"
      ],
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "description": "Ruff updates are reviewed individually",
      "matchManagers": [
        "pep621"
      ],
      "matchPackageNames": [
        "ruff"
      ],
      "groupName": "Ruff",
      "separateMajorMinor": true
    },
    {
      "description": "uv executable updates are reviewed individually",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "astral-sh/uv"
      ],
      "groupName": "uv",
      "separateMajorMinor": true
    },
    {
      "description": "Group independent generic test tooling updates",
      "matchManagers": [
        "pep621"
      ],
      "matchPackageNames": [
        "aiointercept",
        "packaging"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "Generic pytest tooling"
    },
    {
      "description": "Keep Home Assistant harness compatibility pins owner-managed",
      "matchManagers": [
        "pep621"
      ],
      "matchPackageNames": [
        "pytest-homeassistant-custom-component",
        "homeassistant",
        "pytest",
        "pytest-asyncio"
      ],
      "enabled": false
    }
  ]
}
